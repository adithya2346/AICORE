# AI Image Recovery Service Configuration
# Replace with your actual API key in a local .env file (NEVER commit .env to version control)
AI_API_KEY=your_api_key_here

# Configurable AI Provider: 'openai', 'gemini', 'stability', or 'mock' (for local offline testing)
AI_PROVIDER=openai

# Optional: Specific AI Model identifier (e.g., dall-e-2, imagen-3, etc.)
AI_MODEL=dall-e-2

# Upload Limits & Performance
MAX_UPLOAD_SIZE_MB=50
RECOVERY_TIMEOUT_SECONDS=30
